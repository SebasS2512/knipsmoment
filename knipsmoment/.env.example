# Firebase-Projekt-Konfiguration
# 1. Firebase-Projekt anlegen: https://console.firebase.google.com
# 2. Web-App registrieren, Werte aus der Config hierher kopieren
# 3. Datei als .env.local speichern (KOPIEREN, nicht umbenennen — wird nicht committet)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
