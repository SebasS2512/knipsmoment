rules_version = '2';

// KNIPSMOMENT — Storage Security Rules
// Gäste laden komprimierte JPEGs anonym hoch und brauchen `get` für die
// Download-URL direkt nach dem Upload (Pfade enthalten zufällige UUIDs,
// Auflisten bleibt verboten). Löschen darf nur der Admin.
service firebase.storage {
  match /b/{bucket}/o {
    match /events/{eventId}/photos/{fileName} {
      // Gäste-Upload: nur Bilder, max. 10 MB (Client komprimiert vor Upload — §8)
      allow create: if request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;

      allow get: if true;
      allow list: if false;
      allow delete: if request.auth != null;
      allow update: if false;
    }
  }
}
